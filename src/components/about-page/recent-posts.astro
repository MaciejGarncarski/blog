---
import SectionHeading from "@/components/about-page/section-heading.astro";
import AccentShimmer from "@/components/ui/accent-shimmer.astro";
import { formatPostDate } from "@/lib/utils";
import { getPostsSorted } from "@/lib/get-posts-sorted";
import ArrowRightIcon from "../ui/arrow-right-icon.astro";

const allBlogPosts = await getPostsSorted();
const recentPosts = allBlogPosts.slice(0, 3);
---

<section class="flex flex-col gap-6" aria-labelledby="ostatnie-posty">
  <SectionHeading title="Ostatnie posty" id="ostatnie-posty" />

  <ul class="flex flex-col gap-2.5">
    {recentPosts.map((post) => {
      const slug = post.id;
      const { title, description, publishedDate, updatedDate } = post.data;
      const date = formatPostDate(updatedDate ? updatedDate : publishedDate);

      return (
        <li>
          <a
            class="group border-border/50 bg-card-surface hover:border-accent/30 focus-visible:border-accent/50 relative flex flex-col gap-1.5 rounded-xl border px-4 py-3 outline-none transition-colors duration-200"
            href={`/blog/${slug}`}
          >
            <AccentShimmer opacity={20} />

            <div class="flex items-start gap-3">
              <h3 class="group-hover:text-accent group-focus-visible:text-accent text-sm font-semibold leading-snug transition-colors duration-200">
                {title}
              </h3>
              <time class="text-foreground-secondary ml-auto shrink-0 text-xs font-medium tabular-nums">
                {date}
              </time>
            </div>

            <p class="text-foreground-body line-clamp-2 max-w-[65ch] text-caption leading-relaxed text-pretty">
              {description}
            </p>

            <span class="text-accent mt-0.5 flex items-center gap-1.5 text-xs font-medium opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
              Czytaj
              <ArrowRightIcon size={14} />
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>
