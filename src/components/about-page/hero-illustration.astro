---
type Props = {
  class?: string;
  /** Unikalny prefiks ID gradientów/filtra. Domyślnie losowy, więc komponent można użyć wiele razy. */
  id?: string;
};

const { class: className = "", id } = Astro.props;
const uid = id ?? `hero-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={["hero-illustration", className]}
  viewBox="0 0 420 320"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient
      id={`${uid}-panel`}
      x1="48"
      y1="34"
      x2="372"
      y2="286"
      gradientUnits="userSpaceOnUse"
    >
      <stop
        stop-color="var(--color-background-secondary)"
        stop-opacity="0.95"
      />
      <stop
        offset="1"
        stop-color="var(--color-background)"
        stop-opacity="0.9"
      />
    </linearGradient>
    <linearGradient id={`${uid}-accent`} x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="var(--color-accent)" stop-opacity="0.9" />
      <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0.45" />
    </linearGradient>
    <linearGradient
      id={`${uid}-shimmer`}
      x1="48"
      y1="34"
      x2="372"
      y2="34"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="var(--color-accent)" stop-opacity="0" />
      <stop offset="0.5" stop-color="var(--color-accent)" stop-opacity="0.35" />
      <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0" />
    </linearGradient>
    <radialGradient
      id={`${uid}-ambient`}
      cx="214"
      cy="168"
      r="150"
      gradientUnits="userSpaceOnUse"
      gradientTransform="translate(214 168) scale(1 0.74) translate(-214 -168)"
    >
      <stop stop-color="var(--color-accent)" stop-opacity="0.16" />
      <stop offset="0.6" stop-color="var(--color-accent)" stop-opacity="0.05" />
      <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0" />
    </radialGradient>
    <filter id={`${uid}-glow`} x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="14" />
    </filter>
  </defs>

  <!-- Ambient glow (miękki, bez twardej krawędzi) -->
  <ellipse cx="214" cy="168" rx="190" ry="140" fill={`url(#${uid}-ambient)`} />

  <!-- Accent-colored glow under the window -->
  <rect
    x="56"
    y="64"
    width="276"
    height="206"
    rx="20"
    fill="var(--color-accent)"
    fill-opacity="0.16"
    filter={`url(#${uid}-glow)`}
  />

  <!-- Main editor window -->
  <rect
    x="48"
    y="52"
    width="292"
    height="214"
    rx="20"
    fill={`url(#${uid}-panel)`}
    stroke="var(--color-border)"
  />

  <!-- Top bar -->
  <path
    d="M48 72C48 60.9543 56.9543 52 68 52H320C331.046 52 340 60.9543 340 72V84H48V72Z"
    fill="var(--color-accent)"
    fill-opacity="0.05"
  />
  <line x1="48" y1="84" x2="340" y2="84" stroke="var(--color-border)" />
  <line x1="68" y1="52.5" x2="320" y2="52.5" stroke={`url(#${uid}-shimmer)`} />

  <!-- Window controls -->
  <circle
    cx="72"
    cy="68"
    r="4.5"
    fill="var(--color-accent)"
    fill-opacity="0.28"
  />
  <circle
    cx="88"
    cy="68"
    r="4.5"
    fill="var(--color-accent)"
    fill-opacity="0.18"
  />
  <circle
    cx="104"
    cy="68"
    r="4.5"
    fill="var(--color-accent)"
    fill-opacity="0.12"
  />
  <rect
    x="148"
    y="61"
    width="92"
    height="14"
    rx="7"
    fill="var(--color-accent)"
    fill-opacity="0.08"
    stroke="var(--color-border)"
  />
  <circle
    cx="158"
    cy="68"
    r="2"
    fill="var(--color-accent)"
    fill-opacity="0.55"
  />
  <rect
    x="165"
    y="66"
    width="52"
    height="4"
    rx="2"
    fill="var(--color-foreground-secondary)"
    fill-opacity="0.4"
  />

  <!-- Line numbers (stały krok 20 px, zgodny z wierszami kodu) -->
  <g
    class="line-numbers"
    fill="var(--color-foreground-secondary)"
    fill-opacity="0.35"
    font-family="ui-monospace, SFMono-Regular, Menlo, monospace"
    font-size="10"
  >
    <text x="66" y="112">
      1
    </text>
    <text x="66" y="132">
      2
    </text>
    <text x="66" y="152">
      3
    </text>
    <text x="66" y="172">
      4
    </text>
    <text x="66" y="192">
      5
    </text>
    <text x="66" y="212">
      6
    </text>
    <text x="66" y="232">
      7
    </text>
  </g>
  <line
    x1="84"
    y1="96"
    x2="84"
    y2="252"
    stroke="var(--color-border)"
    stroke-opacity="0.7"
  />

  <!-- Code lines -->
  <rect
    x="98"
    y="104"
    width="44"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.55"
  />
  <rect
    x="148"
    y="104"
    width="58"
    height="8"
    rx="4"
    fill="var(--color-foreground-secondary)"
    fill-opacity="0.32"
  />
  <rect
    x="212"
    y="104"
    width="34"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.26"
  />

  <rect
    x="114"
    y="124"
    width="52"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.4"
  />
  <rect
    x="172"
    y="124"
    width="76"
    height="8"
    rx="4"
    fill="var(--color-foreground-secondary)"
    fill-opacity="0.28"
  />
  <rect
    x="254"
    y="124"
    width="28"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.22"
  />

  <rect
    x="114"
    y="144"
    width="36"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.32"
  />
  <rect
    x="156"
    y="144"
    width="96"
    height="8"
    rx="4"
    fill="var(--color-foreground-secondary)"
    fill-opacity="0.26"
  />

  <rect
    x="114"
    y="164"
    width="68"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.46"
  />
  <rect
    x="188"
    y="164"
    width="40"
    height="8"
    rx="4"
    fill="var(--color-foreground-secondary)"
    fill-opacity="0.3"
  />
  <rect
    x="234"
    y="164"
    width="52"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.2"
  />

  <rect
    x="114"
    y="184"
    width="84"
    height="8"
    rx="4"
    fill="var(--color-foreground-secondary)"
    fill-opacity="0.28"
  />
  <rect
    x="204"
    y="184"
    width="46"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.28"
  />

  <rect
    x="98"
    y="204"
    width="26"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.5"
  />

  <!-- Active line highlight (wiersz 7, y=224 jak reszta siatki) -->
  <rect
    x="85"
    y="218"
    width="255"
    height="20"
    rx="6"
    fill="var(--color-accent)"
    fill-opacity="0.08"
  />
  <rect
    x="98"
    y="224"
    width="62"
    height="8"
    rx="4"
    fill="var(--color-accent)"
    fill-opacity="0.55"
  />
  <rect
    x="166"
    y="224"
    width="72"
    height="8"
    rx="4"
    fill="var(--color-foreground-secondary)"
    fill-opacity="0.3"
  />
  <rect
    class="cursor"
    x="244"
    y="221"
    width="2.5"
    height="14"
    rx="1.25"
    fill={`url(#${uid}-accent)`}
  />

  <!-- Floating bracket card (na wierzchu okna, w całości widoczna) -->
  <g transform="translate(298 24)">
    <g class="float float-a">
      <rect
        x="0.5"
        y="0.5"
        width="87"
        height="58"
        rx="14"
        fill="var(--color-background)"
        fill-opacity="0.92"
        stroke="var(--color-border)"
      />
      <path
        d="M30 20L22 29L30 38"
        stroke="var(--color-accent)"
        stroke-opacity="0.9"
        stroke-width="3.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M58 20L66 29L58 38"
        stroke="var(--color-accent)"
        stroke-opacity="0.9"
        stroke-width="3.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path
        d="M48 18L40 40"
        stroke="var(--color-foreground-secondary)"
        stroke-opacity="0.6"
        stroke-width="3.2"
        stroke-linecap="round"
      />
    </g>
  </g>

  <!-- Floating status card -->
  <g transform="translate(258 228)">
    <g class="float float-b">
      <rect
        x="0.5"
        y="0.5"
        width="108"
        height="56"
        rx="14"
        fill="var(--color-background)"
        fill-opacity="0.9"
        stroke="var(--color-border)"
      />
      <circle
        cx="22"
        cy="20"
        r="8"
        fill="var(--color-accent)"
        fill-opacity="0.12"
        stroke="var(--color-accent)"
        stroke-opacity="0.35"
      />
      <path
        d="M19 20.5L21.2 22.7L25.5 17.8"
        stroke="var(--color-accent)"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <rect
        x="36"
        y="16"
        width="46"
        height="5"
        rx="2.5"
        fill="var(--color-foreground-secondary)"
        fill-opacity="0.4"
      />
      <rect
        x="36"
        y="26"
        width="58"
        height="4"
        rx="2"
        fill="var(--color-foreground-secondary)"
        fill-opacity="0.25"
      />
      <rect
        x="14"
        y="40"
        width="80"
        height="5"
        rx="2.5"
        fill="var(--color-accent)"
        fill-opacity="0.12"
      />
      <rect
        x="14"
        y="40"
        width="54"
        height="5"
        rx="2.5"
        fill="var(--color-accent)"
        fill-opacity="0.5"
      />
    </g>
  </g>
</svg>

<style>
  .cursor {
    animation: blink 1.8s steps(1) infinite;
  }

  .float {
    animation: float 11s ease-in-out infinite;
  }

  .float-b {
    animation-duration: 13s;
    animation-delay: -4s;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes float {
    50% {
      transform: translateY(-4px);
    }
  }

  /* Numery linii są zbyt małe na wąskich ekranach */
  @media (max-width: 480px) {
    .line-numbers {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .float {
      animation: none;
    }
  }
</style>
