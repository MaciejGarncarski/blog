---
type Props = {
    class?: string;
    id?: string;
};

const { class: className = "", id } = Astro.props;
const uid = id ?? `hero-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
    class:list={["hero-architecture", className]}
    viewBox="0 0 420 320"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
>
    <defs>
        <radialGradient
            id={`${uid}-ambient`}
            cx="210"
            cy="160"
            r="170"
            gradientUnits="userSpaceOnUse"
            gradientTransform="translate(210 160) scale(1 0.8) translate(-210 -160)"
        >
            <stop stop-color="var(--color-accent)" stop-opacity="0.16" />
            <stop
                offset="0.6"
                stop-color="var(--color-accent)"
                stop-opacity="0.05"
            />
            <stop
                offset="1"
                stop-color="var(--color-accent)"
                stop-opacity="0"
            />
        </radialGradient>
        <filter id={`${uid}-glow`} x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="12" />
        </filter>
    </defs>

    <ellipse
        cx="210"
        cy="160"
        rx="200"
        ry="150"
        fill={`url(#${uid}-ambient)`}
    />

    <!-- Connections (przerywana linia płynie powoli) -->
    <g
        class="flow"
        stroke="var(--color-accent)"
        stroke-opacity="0.5"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="2 7"
    >
        <path d="M88 112C88 150 130 159 158 159" />
        <path d="M262 159C300 159 332 150 332 112" />
        <path d="M190 190C190 205 148 200 148 216" />
        <path d="M230 190C230 205 304 200 304 216" />
    </g>
    <g fill="var(--color-accent)" fill-opacity="0.5">
        <circle cx="88" cy="112" r="3" />
        <circle cx="332" cy="112" r="3" />
        <circle cx="148" cy="216" r="3" />
        <circle cx="304" cy="216" r="3" />
    </g>

    <!-- Center node (API) with accent glow -->
    <rect
        x="160"
        y="136"
        width="100"
        height="62"
        rx="16"
        fill="var(--color-accent)"
        fill-opacity="0.22"
        filter={`url(#${uid}-glow)`}
    />
    <g transform="translate(158 128)">
        <rect
            x="0.5"
            y="0.5"
            width="103"
            height="61"
            rx="16"
            fill="var(--color-background)"
            fill-opacity="0.95"
            stroke="var(--color-accent)"
            stroke-opacity="0.55"
        />
        <circle
            cx="26"
            cy="31"
            r="12"
            fill="var(--color-accent)"
            fill-opacity="0.14"
            stroke="var(--color-accent)"
            stroke-opacity="0.4"
        />
        <path
            d="M22 26L17.5 31L22 36M30 26L34.5 31L30 36"
            stroke="var(--color-accent)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        />
        <rect
            x="46"
            y="24"
            width="46"
            height="5"
            rx="2.5"
            fill="var(--color-foreground-secondary)"
            fill-opacity="0.4"
        />
        <rect
            x="46"
            y="34"
            width="30"
            height="4"
            rx="2"
            fill="var(--color-foreground-secondary)"
            fill-opacity="0.25"
        />
        <rect
            x="16"
            y="50"
            width="72"
            height="4"
            rx="2"
            fill="var(--color-accent)"
            fill-opacity="0.12"
        />
        <rect
            x="16"
            y="50"
            width="46"
            height="4"
            rx="2"
            fill="var(--color-accent)"
            fill-opacity="0.5"
        />
    </g>

    <!-- Node: client -->
    <g transform="translate(36 50)">
        <g class="float float-a">
            <rect
                x="0.5"
                y="0.5"
                width="103"
                height="61"
                rx="16"
                fill="var(--color-background)"
                fill-opacity="0.92"
                stroke="var(--color-border)"
            />
            <circle
                cx="26"
                cy="31"
                r="12"
                fill="var(--color-accent)"
                fill-opacity="0.1"
                stroke="var(--color-accent)"
                stroke-opacity="0.3"
            />
            <rect
                x="19.5"
                y="25.5"
                width="13"
                height="11"
                rx="2"
                stroke="var(--color-accent)"
                stroke-width="1.8"
            />
            <path
                d="M19.5 29.5H32.5"
                stroke="var(--color-accent)"
                stroke-width="1.8"
            />
            <rect
                x="46"
                y="24"
                width="46"
                height="5"
                rx="2.5"
                fill="var(--color-foreground-secondary)"
                fill-opacity="0.4"
            />
            <rect
                x="46"
                y="34"
                width="32"
                height="4"
                rx="2"
                fill="var(--color-foreground-secondary)"
                fill-opacity="0.25"
            />
        </g>
    </g>

    <!-- Node: database -->
    <g transform="translate(280 50)">
        <g class="float float-b">
            <rect
                x="0.5"
                y="0.5"
                width="103"
                height="61"
                rx="16"
                fill="var(--color-background)"
                fill-opacity="0.92"
                stroke="var(--color-border)"
            />
            <circle
                cx="26"
                cy="31"
                r="12"
                fill="var(--color-accent)"
                fill-opacity="0.1"
                stroke="var(--color-accent)"
                stroke-opacity="0.3"
            />
            <ellipse
                cx="26"
                cy="26.5"
                rx="6.5"
                ry="2.8"
                stroke="var(--color-accent)"
                stroke-width="1.8"
            />
            <path
                d="M19.5 26.5V35.5C19.5 37 22.4 38.2 26 38.2C29.6 38.2 32.5 37 32.5 35.5V26.5"
                stroke="var(--color-accent)"
                stroke-width="1.8"
            />
            <rect
                x="46"
                y="24"
                width="46"
                height="5"
                rx="2.5"
                fill="var(--color-foreground-secondary)"
                fill-opacity="0.4"
            />
            <rect
                x="46"
                y="34"
                width="32"
                height="4"
                rx="2"
                fill="var(--color-foreground-secondary)"
                fill-opacity="0.25"
            />
        </g>
    </g>

    <!-- Node: cache -->
    <g transform="translate(96 216)">
        <g class="float float-b">
            <rect
                x="0.5"
                y="0.5"
                width="103"
                height="61"
                rx="16"
                fill="var(--color-background)"
                fill-opacity="0.92"
                stroke="var(--color-border)"
            />
            <circle
                cx="26"
                cy="31"
                r="12"
                fill="var(--color-accent)"
                fill-opacity="0.1"
                stroke="var(--color-accent)"
                stroke-opacity="0.3"
            />
            <path
                d="M27.5 23.5L21.5 32H26L24.5 38.5L30.5 30H26Z"
                stroke="var(--color-accent)"
                stroke-width="1.8"
                stroke-linejoin="round"
            />
            <rect
                x="46"
                y="24"
                width="46"
                height="5"
                rx="2.5"
                fill="var(--color-foreground-secondary)"
                fill-opacity="0.4"
            />
            <rect
                x="46"
                y="34"
                width="32"
                height="4"
                rx="2"
                fill="var(--color-foreground-secondary)"
                fill-opacity="0.25"
            />
        </g>
    </g>

    <!-- Node: queue -->
    <g transform="translate(252 216)">
        <g class="float float-a">
            <rect
                x="0.5"
                y="0.5"
                width="103"
                height="61"
                rx="16"
                fill="var(--color-background)"
                fill-opacity="0.92"
                stroke="var(--color-border)"
            />
            <circle
                cx="26"
                cy="31"
                r="12"
                fill="var(--color-accent)"
                fill-opacity="0.1"
                stroke="var(--color-accent)"
                stroke-opacity="0.3"
            />
            <path
                d="M20 26H32M20 31H32M20 36H27"
                stroke="var(--color-accent)"
                stroke-width="1.8"
                stroke-linecap="round"
            />
            <rect
                x="46"
                y="24"
                width="46"
                height="5"
                rx="2.5"
                fill="var(--color-foreground-secondary)"
                fill-opacity="0.4"
            />
            <rect
                x="46"
                y="34"
                width="32"
                height="4"
                rx="2"
                fill="var(--color-foreground-secondary)"
                fill-opacity="0.25"
            />
        </g>
    </g>
</svg>

<style>
    .flow {
        animation: flow 14s linear infinite;
    }

    .float {
        animation: float 11s ease-in-out infinite;
    }

    .float-b {
        animation-duration: 13s;
        animation-delay: -4s;
    }

    @keyframes flow {
        to {
            stroke-dashoffset: -72;
        }
    }

    @keyframes float {
        50% {
            transform: translateY(-3px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .flow,
        .float {
            animation: none;
        }
    }
</style>
