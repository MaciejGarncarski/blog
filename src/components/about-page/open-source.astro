---
import SectionHeading from "@/components/about-page/section-heading.astro";
import AccentShimmer from "@/components/ui/accent-shimmer.astro";

type Contribution = {
  title: string;
  description: string;
  prLink: string;
};

const data: Contribution[] = [
  {
    description:
      "Naprawiłem migotanie interfejsu podczas zmiany motywu jasnego i ciemnego.",
    prLink: "https://github.com/nestjs/docs.nestjs.com/pull/3546",
    title: "NestJS Docs",
  },
  {
    description:
      'Naprawiłem wyświetlanie pendingComponent przy preload="intent".',
    prLink: "https://github.com/TanStack/router/pull/2247",
    title: "TanStack Router",
  },
];
---

<section class="flex flex-col gap-6" aria-labelledby="open-source">
  <div class="flex flex-col gap-2">
    <SectionHeading title="Open Source" id="open-source" />
    <p class="text-foreground-body max-w-[60ch] text-sm leading-relaxed text-pretty">
      Drobne kontrybucje do projektów, z których korzystam na co dzień.
    </p>
  </div>

  <ul class="grid gap-3 md:grid-cols-2">
    {data.map(({ title, description, prLink }) => (
      <li>
        <a
          class="group border-border/50 bg-card-surface hover:border-accent/30 focus-visible:border-accent/50 relative flex h-full items-start gap-4 rounded-xl border p-4 outline-none transition-colors duration-200"
          target="_blank"
          rel="noopener noreferrer"
          href={prLink}
        >
          <AccentShimmer opacity={20} />
          <span class="bg-accent/10 text-accent mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg">
            <svg
              role="img"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              class="size-4.5"
            >
              <path
                fill="currentColor"
                d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
              />
            </svg>
          </span>

          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <div class="flex items-center gap-2">
              <h3 class="text-foreground group-hover:text-accent group-focus-visible:text-accent text-sm font-semibold transition-colors duration-200">
                {title}
              </h3>
            </div>
            <p class="text-foreground-body text-sm leading-relaxed text-pretty">
              {description}
            </p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
