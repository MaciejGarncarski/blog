---
import SectionHeading from "@/components/about-page/section-heading.astro";
import AccentShimmer from "@/components/ui/accent-shimmer.astro";
import Tag from "../tag.astro";

type Highlight = {
  title: string;
  description: string;
  tags?: string[];
};

type Experience = {
  periodStart: string;
  periodEnd: string;
  company: string;
  description: string;
  role: string;
  highlights: Highlight[];
};

function capitalize(str: string) {
  return str.charAt(0).toUpperCase() + str.slice(1);
}

const experiences: Experience[] = [
  {
    periodStart: "2023-11",
    periodEnd: "2026-07",
    company: "Freelance / Kokscraft",
    role: "Full-Stack Developer",
    description:
      "Mój pierwszy większy projekt, który rozwijałem samodzielnie przez kilka lat jako freelancer. Dzięki niemu zdobyłem doświadczenie w projektowaniu architektury aplikacji, dbaniu o bezpieczeństwo i wydajność oraz rozwijaniu systemu w dłuższej perspektywie. Pracując bezpośrednio z klientem, nauczyłem się zbierać wymagania, jasno komunikować i podejmować decyzje techniczne z uwzględnieniem potrzeb biznesowych, rozwijając przy tym umiejętności miękkie i organizacyjne.",
    highlights: [
      {
        title: "Aplikacje SPA",
        description:
          "Projektowanie i rozwój aplikacji SPA z wykorzystaniem React, TypeScript i TanStack Router.",
        tags: ["React", "TypeScript", "TanStack Router"],
      },
      {
        title: "Backend i API",
        description:
          "Tworzenie API, systemów autoryzacji, architektury backendowej w Node.js oraz implementowanie komunikacji realtime i integracji z zewnętrznymi usługami.",
        tags: ["Node.js", "Fastify", "WebSocket"],
      },
      {
        title: "Bazy Danych",
        description:
          "Projektowanie relacyjnych baz danych, optymalizacja zapytań i zarządzanie danymi.",
        tags: ["MySQL", "Prisma"],
      },
      {
        title: "Utrzymanie i Rozwój",
        description:
          "Utrzymanie bezpieczeństwa aplikacji, identyfikowanie potencjalnych podatności, diagnozowanie i usuwanie błędów, optymalizacja wydajności oraz samodzielne prowadzenie projektów od koncepcji, przez wdrożenie, aż po dalsze utrzymanie.",
      },
    ],
  },
];

const months = [
  "stycznia",
  "lutego",
  "marca",
  "kwietnia",
  "maja",
  "czerwca",
  "lipca",
  "sierpnia",
  "września",
  "października",
  "listopada",
  "grudnia",
];

function formatPeriod(start: string, end: string) {
  const [startYear, startMonth] = start.split("-");
  const [endYear, endMonth] = end.split("-");

  return {
    start: `od ${months[Number(startMonth) - 1]} ${startYear}`,
    end: `do ${months[Number(endMonth) - 1]} ${endYear}`,
  };
}
---

<section class="flex flex-col gap-6" aria-labelledby="doswiadczenie">
  <SectionHeading title="Doświadczenie" id="doswiadczenie" />

  {experiences.map((exp) => {
    const period = formatPeriod(exp.periodStart, exp.periodEnd);

    return (
      <article class="grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-10">
        <div class="flex flex-col gap-3 md:sticky md:top-24 md:self-start">
          <p class="text-foreground-secondary text-sm">
            <span>{period.start}</span>
            <span> {period.end}</span>
          </p>

          <div class="flex flex-col gap-0.5">
            <h3 class="text-lg font-semibold leading-snug md:text-xl">
              {exp.role}
            </h3>
            <p class="text-sm leading-snug text-accent">{exp.company}</p>
          </div>

          <p class="text-foreground-body text-sm leading-relaxed text-pretty">
            {exp.description}
          </p>
        </div>

        <ul class="flex flex-col gap-2.5">
          {exp.highlights.map(({ title, description, tags }) => (
            <li class="border-border/50 bg-card-surface hover:border-accent/30 relative flex flex-col gap-1.5 rounded-xl border px-4 py-3 transition-colors duration-200">
              <AccentShimmer opacity={20} />
              <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1.5">
                <span class="text-foreground text-caption font-semibold">
                  {title}
                </span>

                {tags && tags.length > 0 && (
                  <div class="flex flex-wrap gap-1">
                    {tags.map((tag) => (
                      <Tag variant="small">{tag}</Tag>
                    ))}
                  </div>
                )}
              </div>

              <span class="text-foreground-body text-sm leading-relaxed text-pretty">
                {capitalize(description)}
              </span>
            </li>
          ))}
        </ul>
      </article>
    );
  })}
</section>
