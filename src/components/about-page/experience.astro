---
import SectionHeading from "@/components/about-page/section-heading.astro";
import AccentShimmer from "@/components/ui/accent-shimmer.astro";
import Tag from "../tag.astro";

type Highlight = {
  title: string;
  description: string;
  tags?: string[];
};

type Experience = {
  periodStart: string;
  periodEnd: string;
  company: string;
  description: string;
  role: string;
  highlights: Highlight[];
};

function capitalize(str: string) {
  return str.charAt(0).toUpperCase() + str.slice(1);
}

const experiences: Experience[] = [
  {
    periodStart: "2023-11",
    periodEnd: "2026-07",
    company: "Freelance / Kokscraft",
    role: "Full-Stack Developer",
    description:
      "Mój pierwszy większy projekt, który rozwijałem samodzielnie przez kilka lat jako freelancer. Dzięki niemu zdobyłem doświadczenie w projektowaniu architektury aplikacji, dbaniu o bezpieczeństwo i wydajność oraz rozwijaniu systemu w dłuższej perspektywie. Pracując bezpośrednio z klientem, nauczyłem się zbierać wymagania, jasno komunikować i podejmować decyzje techniczne z uwzględnieniem potrzeb biznesowych, rozwijając przy tym umiejętności miękkie i organizacyjne.",
    highlights: [
      {
        title: "System Kontroli Dostępu (RBAC)",
        description:
          "Granularny system uprawnień zwiększający bezpieczeństwo danych i precyzję zarządzania rolami użytkowników.",
        tags: ["Node.js", "MySQL"],
      },
      {
        title: "Komunikacja Real-time",
        description:
          "Moduły oparte o WebSockets umożliwiające monitorowanie aktywności w czasie rzeczywistym przy minimalnym opóźnieniu.",
        tags: ["WebSockets"],
      },
      {
        title: "Zaawansowany UI/UX",
        description:
          "Responsywny frontend z komponentami Data Grid, filtrowaniem po stronie serwera i optymalizacją renderowania.",
        tags: ["React", "TypeScript"],
      },
      {
        title: "Audyt i Logi",
        description:
          "System logowania zdarzeń zapewniający transparentność działań administratorów i historyczność zmian.",
        tags: ["Prisma"],
      },
      {
        title: "Zarządzanie Danymi",
        description:
          "Optymalizacja zapytań i schematów bazodanowych pod dużym obciążeniem.",
        tags: ["Prisma", "MySQL"],
      },
      {
        title: "Maintenance & Security",
        description:
          "Utrzymanie długu technicznego, automatyzacja aktualizacji zależności i spójność architektury.",
        tags: ["Dependabot"],
      },
    ],
  },
];

const months = [
  "stycznia",
  "lutego",
  "marca",
  "kwietnia",
  "maja",
  "czerwca",
  "lipca",
  "sierpnia",
  "września",
  "października",
  "listopada",
  "grudnia",
];

function formatPeriod(start: string, end: string) {
  const [startYear, startMonth] = start.split("-");
  const [endYear, endMonth] = end.split("-");

  return {
    start: `od ${months[Number(startMonth) - 1]} ${startYear}`,
    end: `do ${months[Number(endMonth) - 1]} ${endYear}`,
  };
}
---

<section class="flex flex-col gap-6" aria-labelledby="doswiadczenie">
  <SectionHeading title="Doświadczenie" id="doswiadczenie" />

  {experiences.map((exp) => {
    const period = formatPeriod(exp.periodStart, exp.periodEnd);

    return (
      <article class="grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-10">
        <div class="flex flex-col gap-3 md:sticky md:top-24 md:self-start">
          <p class="text-foreground-secondary text-xs">
            <span>{period.start}</span>
            <span> {period.end}</span>
          </p>

          <div class="flex flex-col gap-0.5">
            <h3 class="text-lg font-semibold leading-snug md:text-xl">
              {exp.role}
            </h3>
            <p class="text-sm leading-snug text-accent">{exp.company}</p>
          </div>

          <p class="text-foreground-body text-sm leading-relaxed text-pretty">
            {exp.description}
          </p>
        </div>

        <ul class="flex flex-col gap-2.5">
          {exp.highlights.map(({ title, description, tags }) => (
            <li class="border-border/50 bg-background-secondary/30 hover:border-accent/30 relative flex flex-col gap-1.5 rounded-xl border px-4 py-3 transition-colors">
              <AccentShimmer opacity={20} />

              <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1.5">
                <span class="text-foreground text-[0.8125rem] font-semibold">
                  {title}
                </span>

                {tags && tags.length > 0 && (
                  <div class="flex flex-wrap gap-1">
                    {tags.map((tag) => (
                      <Tag variant="small">{tag}</Tag>
                    ))}
                  </div>
                )}
              </div>

              <span class="text-foreground-body text-[0.8125rem] leading-relaxed text-pretty">
                {capitalize(description)}
              </span>
            </li>
          ))}
        </ul>
      </article>
    );
  })}
</section>
