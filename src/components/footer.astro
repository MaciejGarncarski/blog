---
import github from "@assets/github.svg";
import linkedin from "@assets/linkedin.svg";
import xIcon from "@assets/x.svg";
import type { SvgComponent } from "astro/types";
import Hr from "@/components/ui/hr.astro";

const currentYear = new Date().getFullYear();

type Social = {
  url: string;
  icon: SvgComponent;
  name: string;
};

const socials: Array<Social> = [
  {
    name: "GitHub",
    icon: github,
    url: "https://github.com/maciejgarncarski",
  },
  {
    name: "LinkedIn",
    icon: linkedin,
    url: "https://www.linkedin.com/in/maciejgarncarski/",
  },
  {
    name: "X",
    icon: xIcon,
    url: "https://x.com/MGarncarski",
  },
];
---

<footer
  class="mx-auto mt-16 max-w-[63rem] md:mt-28 relative"
  transition:name="footer"
>
  <Hr class="flex-1" />
  <div class="py-6">
    <div class="flex flex-col items-center gap-5 md:flex-row md:justify-between">
      <p class="text-foreground-secondary text-caption">
        &copy; {currentYear} Maciej Garncarski
      </p>

      <div class="flex items-center gap-1">
        {socials.map((s) => {
          const Icon = s.icon;

          return (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              title={s.name}
              class="text-foreground-secondary hover:text-foreground flex size-8 items-center justify-center rounded-md transition-colors duration-150 hover:bg-foreground/5"
            >
              <Icon class="size-[15px] text-foreground" />
              <span class="sr-only">{s.name}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</footer>
