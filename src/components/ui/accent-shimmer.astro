---
type Props = {
  opacity?: number;
  insetX?: string;
};

const { opacity = 20, insetX = "10%" } = Astro.props;
---

<div
  class="pointer-events-none absolute top-0 z-10 h-px"
  style={`inset-inline: ${insetX}; background-image: linear-gradient(to right, transparent, color-mix(in oklab, var(--color-accent) ${opacity}%, transparent), transparent);`}
  aria-hidden="true"
>
</div>
