---
type Props = {
   size?: number;
   customStyles?: string;
};

const { size = 16, customStyles } = Astro.props;
---
<svg
   xmlns="http://www.w3.org/2000/svg"
   width={size}
   height={size}
   viewBox="0 0 24 24"
   fill="none"
   stroke="currentColor"
   stroke-width="2"
   stroke-linecap="round"
   stroke-linejoin="round"
   aria-hidden="true"
   class:list={["inline-block align-middle shrink-0", customStyles]}
>
   <path d="M5 12h14" />
   <path d="m12 5 7 7-7 7" />
</svg>
