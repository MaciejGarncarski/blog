---
const defaultTitle = "Maciej Garncarski — Software Engineer";
const defaultDescription =
  "Software Engineer specjalizujący się w skalowalnych systemach webowych. React, TypeScript, Node.js — od architektury po wdrożenie.";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  publishedDate?: string;
  updatedDate?: string;
  category?: string;
  tags?: Array<string>;
  jsonLdType?: "Article" | "WebPage" | "CollectionPage";
  robots?: string;
  inLanguage?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
  itemListItems?: Array<{ name: string; url: string }>;
};

const {
  description = defaultDescription,
  title,
  ogImage = "/og.png",
  publishedDate,
  updatedDate,
  canonicalUrl: manualCanonical,
  category = "Technology",
  tags = [],
  robots,
  inLanguage = "pl-PL",
  breadcrumbs,
  itemListItems,
} = Astro.props;

const fullTitle = title ? `${title} | Maciej Garncarski` : defaultTitle;
const manualCanonicalUrl = manualCanonical
  ? new URL(manualCanonical, Astro.site).toString()
  : null;
const canonicalUrl =
  manualCanonicalUrl || new URL(Astro.url.pathname, Astro.site).toString();
const fullOgImageUrl = new URL(ogImage, Astro.site).toString();
const siteUrl = new URL("/", Astro.site).toString();
const blogUrl = new URL("/blog", Astro.site).toString();
const socialProfiles = [
  "https://github.com/maciejgarncarski",
  "https://www.linkedin.com/in/maciejgarncarski/",
  "https://x.com/MGarncarski",
];
const organizationId = `${siteUrl}#organization`;
const personId = `${siteUrl}#person`;
const websiteId = `${siteUrl}#website`;

const formattedDate = publishedDate
  ? new Date(publishedDate).toISOString()
  : new Date().toISOString();
const formattedModifiedDate = updatedDate
  ? new Date(updatedDate).toISOString()
  : undefined;

const publisherSchema = {
  "@id": organizationId,
  "@type": "Organization",
  name: "Maciej Garncarski",
  url: siteUrl,
  sameAs: socialProfiles,
  logo: {
    "@type": "ImageObject",
    url: "https://maciejg.dev/favicon.svg",
  },
};

const authorSchema = {
  "@id": personId,
  "@type": "Person",
  name: "Maciej Garncarski",
  url: siteUrl,
  sameAs: socialProfiles,
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: defaultTitle,
  url: siteUrl,
  inLanguage: inLanguage,
  publisher: {
    "@id": organizationId,
  },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl}blog?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

const webSiteReference = {
  "@id": websiteId,
};

const blogReference = {
  "@type": "Blog",
  "@id": `${blogUrl}#blog`,
  name: "Blog",
  url: blogUrl,
};

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title || defaultTitle,
  description: description,
  url: canonicalUrl,
  inLanguage: inLanguage,
  publisher: publisherSchema,
  isPartOf: webSiteReference,
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title || defaultTitle,
  description: description,
  url: canonicalUrl,
  inLanguage: inLanguage,
  publisher: publisherSchema,
  isPartOf: webSiteReference,
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title || defaultTitle,
  description: description,
  image: fullOgImageUrl,
  inLanguage: inLanguage,
  author: {
    "@id": personId,
  },
  datePublished: formattedDate,
  dateModified: formattedModifiedDate,
  publisher: {
    "@id": organizationId,
  },
  isPartOf: blogReference,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
};

const breadcrumbSchema = breadcrumbs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: crumb.url,
      })),
    }
  : null;

const itemListSchema = itemListItems?.length
  ? {
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListOrder: "https://schema.org/ItemListOrderAscending",
      numberOfItems: itemListItems.length,
      itemListElement: itemListItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        url: item.url,
      })),
    }
  : null;

const jsonLdType =
  Astro.props.jsonLdType || (publishedDate ? "Article" : "WebPage");
const structuredData = [
  webSiteSchema,
  publisherSchema,
  authorSchema,
  jsonLdType === "Article"
    ? articleSchema
    : jsonLdType === "CollectionPage"
      ? collectionPageSchema
      : webPageSchema,
  breadcrumbSchema,
  itemListSchema,
].filter(Boolean);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#f5f9ff" />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={publishedDate ? "article" : "website"} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={fullOgImageUrl} />
<meta property="og:site_name" content={"Maciej Garncarski"} />

{
  publishedDate && (
    <>
      <meta property="article:published_time" content={formattedDate} />
      <meta property="article:author" content="https://maciejg.dev" />
      <meta property="article:section" content={category} />
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImageUrl} />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(
    structuredData.length === 1 ? structuredData[0] : structuredData,
  )}
/>
