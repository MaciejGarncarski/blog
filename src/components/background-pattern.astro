<div
  class="text-accent pointer-events-none fixed inset-0 z-0 overflow-hidden"
  aria-hidden="true"
>
  <!-- Soft glow nad nagłówkiem -->
  <div class="absolute inset-0 opacity-70 bg-[radial-gradient(ellipse_60%_35%_at_50%_0%,color-mix(in_oklab,currentColor_14%,transparent),transparent)]"></div>

  <!-- Siatka: kropki co 32px, krzyżyki co 160px w tych samych węzłach -->
  <div class="absolute inset-0 opacity-10 md:opacity-20 md:mask-[radial-gradient(ellipse_70%_85%_at_50%_50%,transparent_25%,black_75%)]">
    <svg
      class="size-full"
      xmlns="http://www.w3.org/2000/svg"
      width="100%"
      height="100%"
    >
      <defs>
        <pattern
          id="bg-dots"
          width="32"
          height="32"
          patternUnits="userSpaceOnUse"
        >
          <circle cx="1" cy="1" r="1" fill="currentColor"></circle>
        </pattern>
        <pattern
          id="bg-crosses"
          width="160"
          height="160"
          patternUnits="userSpaceOnUse"
        >
          <path
            d="M58 65H72M65 58V72"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
          ></path>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#bg-dots)"></rect>
      <rect
        width="100%"
        height="100%"
        fill="url(#bg-crosses)"
        class="hidden md:block"
      ></rect>
    </svg>
  </div>
</div>
