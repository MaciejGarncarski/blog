---
import BlogItem from "@/components/blog/blog-item.astro";
import { formatPostDate } from "@/lib/utils";

type Props = {
  posts: Array<{
    id: string;
    readingTime: number;
    data: {
      title: string;
      description: string;
      publishedDate: Date;
      updatedDate?: Date;
      tags?: string[];
    };
  }>;
};

const { posts } = Astro.props;
---

<ul class="flex flex-col gap-3">
  {posts.map((post) => {
    const displayDate = post.data.updatedDate ?? post.data.publishedDate;
    const formattedTime = formatPostDate(displayDate);
    const isoDate = new Date(displayDate).toISOString();

    return (
      <li>
        <BlogItem post={post} formattedTime={formattedTime} isoDate={isoDate} />
      </li>
    );
  })}
</ul>
