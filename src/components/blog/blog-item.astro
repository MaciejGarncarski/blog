---
import AccentShimmer from "../ui/accent-shimmer.astro";
import Tag from "@/components/tag.astro";

type Props = {
  post: {
    id: string;
    readingTime: number;
    data: {
      title: string;
      description: string;
      publishedDate: Date;
      updatedDate?: Date;
      tags?: string[];
    };
  };
  formattedTime: string;
  isoDate: string;
};

const { post, formattedTime, isoDate } = Astro.props;
const hasTags = post.data.tags && post.data.tags.length > 0;
---

<a
  href={"/blog/" + post.id}
  class="group border-border/50 bg-background-secondary/30 hover:border-accent/30 focus-visible:border-accent/50 relative flex flex-col gap-2 overflow-hidden rounded-xl border px-4 py-3.5 outline-none transition-colors md:px-5 md:py-4"
>
  <AccentShimmer opacity={20} />

  <div class="flex items-start gap-3">
    <h2 class="group-hover:text-accent group-focus-visible:text-accent text-base leading-snug font-semibold text-pretty transition-colors duration-200 md:text-lg">
      {post.data.title}
    </h2>
    <time
      datetime={isoDate}
      class="text-foreground-secondary mt-1 ml-auto shrink-0 text-xs font-medium tabular-nums"
    >
      {formattedTime}
    </time>
  </div>

  <p class="text-foreground-body line-clamp-3 max-w-[65ch] text-sm leading-relaxed text-pretty">
    {post.data.description}
  </p>

  {(hasTags || post.readingTime) && (
    <div class="mt-1 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
      {hasTags ? (
        <div class="flex flex-wrap gap-1.5">
          {post.data.tags!.map((tag) => (
            <Tag variant="small">{tag}</Tag>
          ))}
        </div>
      ) : (
        <span />
      )}

      {post.readingTime ? (
        <span class="text-foreground-secondary text-xs">
          {Math.ceil(post.readingTime)} min czytania
        </span>
      ) : null}
    </div>
  )}
</a>
