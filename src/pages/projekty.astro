---
import { Picture } from "astro:assets";

import Layout from "@layouts/layout.astro";
import Seo from "@/components/seo.astro";
import Tag from "@/components/tag.astro";
import { projects } from "@/data/projects";
import AccentShimmer from "@/components/ui/accent-shimmer.astro";

const seoData = {
  title: "Projekty",
  description:
    "Przeglądaj moje najciekawsze projekty programistyczne, które pokazują moje umiejętności i pasję do tworzenia innowacyjnych rozwiązań.",
};
---

<Layout>
  <Seo slot="head" description={seoData.description} title={seoData.title} />
  <div class="mx-auto flex w-full max-w-[50rem] flex-col gap-8">
    <header class="flex flex-col gap-3">
      <p class="text-accent text-sm font-semibold uppercase tracking-widest">
        Portfolio
      </p>
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Projekty</h1>
      <p
        class="text-foreground-body max-w-[65ch] text-lg leading-relaxed text-pretty"
      >
        Najciekawsze projekty, które pokazują moje umiejętności i pasję do
        tworzenia innowacyjnych rozwiązań.
      </p>
    </header>

    <ul class="grid gap-6">
      {
        projects.map((project, idx) => {
          return (
            <li>
              <a href={`/projekty/${project.id}`} class="group block">
                <article class="bg-background-secondary/50 relative flex flex-col gap-5 overflow-hidden rounded-xl border border-accent/12 p-4 transition-all duration-200 hover:border-accent/30 md:min-h-42 md:flex-row md:items-center md:gap-8">
                  <AccentShimmer />
                  {project.thumbnail ? (
                    <div
                      class="relative isolate w-full shrink-0 overflow-hidden rounded-lg bg-accent/10 border border-accent/10 p-0.5 md:w-54 lg:w-60"
                      style="aspect-ratio: 128 / 63;"
                    >
                      <Picture
                        formats={["jxl", "webp"]}
                        src={project.thumbnail}
                        alt={project.title}
                        width={1024}
                        height={504}
                        widths={[512, 768, 1024]}
                        sizes="(max-width: 767px) calc(100vw - 3rem), 15rem"
                        fit="cover"
                        position="center"
                        priority={idx < 2}
                        pictureAttributes={{
                          class: "relative z-10 block size-full",
                        }}
                        class="size-full rounded-lg object-cover"
                      />
                    </div>
                  ) : (
                    <div class="border-foreground/10 bg-background flex h-32 w-full shrink-0 items-center justify-center rounded-lg border md:w-54 lg:w-60">
                      <p class="text-foreground-secondary text-xs">
                        Brak podglądu
                      </p>
                    </div>
                  )}
                  <div class="min-w-0 flex-1">
                    <h2 class="text-foreground mb-2 text-xl font-semibold text-pretty transition-colors group-hover:text-accent">
                      {project.title}
                    </h2>
                    <p class="text-foreground-secondary mb-3 text-sm leading-relaxed line-clamp-2">
                      {project.description}
                    </p>
                    <div class="flex flex-wrap gap-1.5" role="list">
                      {project.tags.slice(0, 4).map((tag) => (
                        <Tag variant="small" role="listitem">
                          {tag}
                        </Tag>
                      ))}
                      {project.tags.length > 4 && (
                        <Tag variant="small">+{project.tags.length - 4}</Tag>
                      )}
                    </div>
                  </div>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="text-foreground-secondary hidden shrink-0 transition-transform group-hover:translate-x-1 md:ml-auto md:block"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </article>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</Layout>
