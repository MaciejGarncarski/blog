---
import { Picture } from "astro:assets";

import Layout from "@layouts/layout.astro";
import Seo from "@/components/seo.astro";
import Tag from "@/components/tag.astro";
import { projects } from "@/data/projects";
import AccentShimmer from "@/components/ui/accent-shimmer.astro";

const seoData = {
  title: "Projekty",
  description:
    "Przeglądaj moje najciekawsze projekty programistyczne, które pokazują moje umiejętności i pasję do tworzenia innowacyjnych rozwiązań.",
};
---

<Layout>
  <Seo slot="head" description={seoData.description} title={seoData.title} />
  <div class="mx-auto flex w-full max-w-[50rem] flex-col gap-8">
    <header class="flex flex-col gap-4">
      <h1 class="text-4xl leading-[1.1] font-bold tracking-tight text-balance md:text-5xl">
        Projekty
      </h1>
      <p class="text-foreground-body max-w-[60ch] text-lg leading-relaxed text-pretty">
        Wybrane projekty, które pokazują, jak podchodzę do budowania aplikacji.
      </p>
    </header>

    <ul class="flex flex-col gap-3">
      {projects.map((project, idx) => (
        <li>
          <a
            href={`/projekty/${project.id}`}
            class="group border-border/50 bg-card-surface hover:border-accent/30 focus-visible:border-accent/50 relative flex flex-col gap-4 overflow-hidden rounded-xl border p-3.5 outline-none transition-colors duration-200 md:flex-row md:items-center md:gap-6"
          >
            <AccentShimmer opacity={20} />

            {project.thumbnail ? (
              <div
                class="border-border/50 bg-background-secondary relative w-full shrink-0 overflow-hidden rounded-lg border md:w-56 lg:w-60"
                style="aspect-ratio: 128 / 63;"
              >
                <Picture
                  formats={["jxl", "webp"]}
                  src={project.thumbnail}
                  alt={project.title}
                  width={1024}
                  height={504}
                  widths={[512, 768, 1024]}
                  sizes="(max-width: 767px) calc(100vw - 3rem), 15rem"
                  fit="cover"
                  position="center"
                  priority={idx < 2}
                  pictureAttributes={{ class: "block size-full" }}
                  class="size-full object-cover"
                />
              </div>
            ) : (
              <div
                class="border-border/50 bg-background text-foreground-secondary flex w-full shrink-0 items-center justify-center rounded-lg border text-xs md:w-56 lg:w-60"
                style="aspect-ratio: 128 / 63;"
              >
                Brak podglądu
              </div>
            )}

            <div class="flex min-w-0 flex-1 flex-col gap-2">
              <h2 class="text-foreground group-hover:text-accent group-focus-visible:text-accent text-lg font-semibold leading-snug text-pretty transition-colors duration-200">
                {project.title}
              </h2>

              <p class="text-foreground-body line-clamp-2 text-caption leading-relaxed">
                {project.description}
              </p>

              <div class="mt-1 flex flex-wrap items-center gap-1.5" role="list">
                {project.tags.slice(0, 4).map((tag) => (
                  <Tag variant="small" role="listitem">
                    {tag}
                  </Tag>
                ))}
                {project.tags.length > 4 && (
                  <Tag variant="small">+{project.tags.length - 4}</Tag>
                )}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
