---
import Experience from "@components/about-page/experience.astro";
import Header from "@components/about-page/header.astro";
import OpenSource from "@components/about-page/open-source.astro";
import Layout from "@layouts/layout.astro";
import Seo from "@/components/seo.astro";
import Technologies from "@/components/about-page/technologies.astro";
import HomeSectionBorder from "@/components/home-section-border.astro";
import RecentPosts from "@/components/about-page/recent-posts.astro";

const seoData = {
  title: "Programista aplikacji webowych",
  description:
    "Tworzę aplikacje webowe w React, TypeScript i Node.js. Piszę o programowaniu, projektowaniu systemów i doświadczeniach z pracy nad projektami.",
};
---

<Layout>
  <Seo slot="head" description={seoData.description} title={seoData.title} />
  <div class="mx-auto flex w-full max-w-[50rem] flex-col gap-10">
    <Header />

    <HomeSectionBorder>
      <Experience />
    </HomeSectionBorder>

    <HomeSectionBorder>
      <OpenSource />
    </HomeSectionBorder>

    <HomeSectionBorder>
      <Technologies />
    </HomeSectionBorder>

    <HomeSectionBorder>
      <RecentPosts />
    </HomeSectionBorder>
  </div>
</Layout>
