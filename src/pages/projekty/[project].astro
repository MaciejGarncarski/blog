---
import ProjectLink from "@/components/projects/project-link.astro";
import SectionHeading from "@/components/about-page/section-heading.astro";
import Seo from "@/components/seo.astro";
import Tag from "@/components/tag.astro";
import { projects } from "@/data/projects";
import Layout from "@/layouts/layout.astro";
import { Picture } from "astro:assets";
import ChevronIcon from "@/components/ui/chevron-icon.astro";
import AccentShimmer from "@/components/ui/accent-shimmer.astro";
import { getImagePlaceholder } from "@miyamo2/astro-image-placeholder";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { project: project.id },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;
const projectPlaceholder = project.thumbnail
  ? await getImagePlaceholder(project.thumbnail)
  : undefined;
const projectUrl = new URL(`/projekty/${project.id}`, Astro.site).toString();
const projectImageUrl = project.thumbnail
  ? new URL(project.thumbnail.src, Astro.site).toString()
  : undefined;
const breadcrumbs = [
  { name: "Home", url: new URL("/", Astro.site).toString() },
  { name: "Projekty", url: new URL("/projekty", Astro.site).toString() },
  { name: project.title, url: projectUrl },
];

const projectSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.description,
  url: projectUrl,
  image: projectImageUrl,
  creator: {
    "@type": "Person",
    name: "Maciej Garncarski",
    url: "https://maciejg.dev",
  },
  codeRepository: project.github,
  sameAs: [project.github, ...(project.demo ? [project.demo] : [])],
};
---

<Layout>
  <Seo
    slot="head"
    title={project.title}
    description={project.description}
    breadcrumbs={breadcrumbs}
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(projectSchema)}
  />

  <div class="mx-auto flex w-full max-w-[50rem] flex-col gap-10">
    <a
      href="/projekty"
      class="text-foreground-secondary hover:text-foreground group inline-flex w-fit items-center gap-2 text-sm transition-colors"
    >
      <ChevronIcon
        size={16}
        direction="left"
        customStyles="transition-transform group-hover:-translate-x-1"
      />
      Wróć do projektów
    </a>

    <header class="flex flex-col gap-4">
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
        {project.title}
      </h1>
      <p class="text-foreground-secondary text-lg leading-relaxed">
        {project.description}
      </p>
    </header>

    <div class="relative">
      <AccentShimmer />
      {
        project.thumbnail ? (
          <div
            class="relative isolate w-full p-0.5 overflow-hidden rounded-xl border border-accent/12 bg-accent/12 shadow-accent shadow-xs"
            style="aspect-ratio: 128 / 63;"
          >
            {projectPlaceholder && (
              <img
                class="absolute inset-0 size-full object-cover p-1 rounded-xl"
                src={projectPlaceholder}
                alt=""
                aria-hidden="true"
              />
            )}
            <Picture
              formats={["avif", "webp"]}
              priority={true}
              src={project.thumbnail}
              alt={project.title}
              width={1792}
              height={882}
              widths={[768, 1280, 1792]}
              sizes="(max-width: 832px) calc(100vw - 2rem), 50rem"
              fit="cover"
              position="center"
              pictureAttributes={{ class: "relative z-10 block size-full" }}
              class="size-full rounded-xl object-cover"
            />
          </div>
        ) : (
          <div class="flex h-48 md:h-82 items-center justify-center rounded-xl border border-accent/12 bg-background-secondary/20 text-foreground-secondary">
            Brak podglądu
          </div>
        )
      }
    </div>

    <p class="text-foreground-secondary text-lg leading-relaxed">
      {project.descriptionSecondary}
    </p>

    <section class="flex flex-col gap-3" aria-labelledby="technologie">
      <SectionHeading title="Technologie" id="technologie" />
      <div class="flex flex-wrap gap-2" role="list">
        {project.tags.map((tag) => <Tag role="listitem">{tag}</Tag>)}
      </div>
    </section>

    <section class="flex flex-col gap-3" aria-labelledby="linki">
      <SectionHeading title="Linki" id="linki" />
      <div class="flex gap-4 font-semibold md:gap-6">
        {project.demo ? <ProjectLink link={project.demo} type="demo" /> : null}
        <ProjectLink link={project.github} type="repo" />
      </div>
    </section>
  </div>
</Layout>
